# Copy to .env (same folder as docker-compose.yml) and fill in.
# Never commit the .env file.

# Real API keys: Sonarr/Radarr -> Settings -> General -> Security -> API Key
SONARR_API_KEY=
RADARR_API_KEY=

# Keys Seerr uses to talk to Arrmor. One per instance, at least 32 characters.
# Generate with: openssl rand -hex 32
# Enter them in Seerr -> Settings -> Services as the API key.
SONARR_PROXY_KEY=
RADARR_PROXY_KEY=
